# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA comitar: contêm o secret de sessão e as credenciais do
# Google OAuth. O .env.example é a exceção: só tem placeholders e serve de
# referência para quem for configurar o ambiente.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# banco de dados local (libSQL em arquivo)
/.data/

# resíduo da fase Cloudflare: banco D1 local do miniflare. Não é mais usado por
# nada no projeto e pode ser apagado à vontade (`rm -rf .wrangler`); fica
# ignorado para que o binário não entre no repositório enquanto existir.
/.wrangler/


# Backups do banco — contêm todos os dados de produção, inclusive e-mails
# e sessões. Nunca vão para o repositório.
backups/
